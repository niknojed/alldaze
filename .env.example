# Environment variables for AllDazeWork.
# Copy this file to `.env.local` and fill in real values (that file is gitignored).
# In production these are set in Hostinger: Websites → alldaze.studio → Node.js → Environment variables.

# ── Form notifications (/api/audit-request) — SMTP via nodemailer ──
# Sends as the Hostinger mailbox hello@alldaze.studio.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@alldaze.studio
# The mailbox password for hello@alldaze.studio (set in hPanel → Emails).
SMTP_PASS=
# Where form notifications are delivered.
NOTIFY_TO=design@alldazework.com

# ── Talon chatbot (/api/chat) ──
# Anthropic API key — required only if the chat feature is used.
ANTHROPIC_API_KEY=
